diff --git a/src/util.ts b/src/util.ts
index c960263f5..e299d8202 100644
--- a/src/util.ts
+++ b/src/util.ts
@@ -1,5 +1,5 @@
 import { createHash } from "node:crypto";
-import type { AnthropicRequestBody } from "acp-kernel/wire";
+import type { AnthropicRequestBody, GoogleContent, GooglePart } from "acp-kernel/wire";
 
 // #920: stamped per request by the opencode thin plugin for LEGACY
 // opencode-acp sessions (acp state on disk). The proxy (server.ts) forwards
@@ -798,3 +798,33 @@ function blockText(v: unknown): string | undefined {
     }
     return undefined;
 }
+/** True when the model name indicates an Anthropic Claude model. */
+export function isClaudeModel(model: string | undefined): boolean {
+    if (!model) return false;
+    return /claude/i.test(model);
+}
+
+/**
+ * Anthropic wire compatibility on the Google protocol:
+ * When Claude is called via Google Cloud Code Assist / Antigravity, Google translates
+ * Gemini `contents` to Anthropic `messages`. Anthropic enforces that a `tool_use`
+ * block MUST be followed immediately by its corresponding `tool_result` in the next
+ * user message. Plain text parts can never precede `functionResponse` parts, or
+ * Vertex AI Claude rejects the request with a 400 error:
+ * "messages.N: `tool_use` ids were found without `tool_result` blocks immediately after".
+ */
+export function ensureGoogleClaudeWireOrder(contents: GoogleContent[]): GoogleContent[] {
+    return contents.map((c) => {
+        if (c.role !== "user" || !Array.isArray(c.parts)) return c;
+        const frs: GooglePart[] = [];
+        const texts: GooglePart[] = [];
+        const others: GooglePart[] = [];
+        for (const p of c.parts) {
+            if (p.functionResponse !== undefined) frs.push(p);
+            else if (typeof p.text === "string") texts.push(p);
+            else others.push(p);
+        }
+        if (frs.length === 0 || texts.length === 0) return c;
+        return { ...c, parts: [...frs, ...texts, ...others] };
+    });
+}
diff --git a/tests/adapter-google.test.ts b/tests/adapter-google.test.ts
index ac3c7f6d3..8033ba02a 100644
--- a/tests/adapter-google.test.ts
+++ b/tests/adapter-google.test.ts
@@ -349,3 +349,26 @@ test("google parseStream: a null sibling part does not break the edited frame",
     const frames = framesOf(events);
     assert.ok(frames.some((f) => f.includes("kept prose")), `the prose still reaches the client, got: ${frames.join(" | ")}`);
 });
+
+test("google buildRequest: ensure tool_result precedes text for Claude models on Google wire", () => {
+    const messages: CoreMessage[] = [
+        { id: "m1", role: "assistant", contentType: "tool-call", toolName: "read", toolCallId: "toolu_123", text: "{}" },
+        { id: "m2", role: "tool", contentType: "tool-result", toolName: "read", toolCallId: "toolu_123", text: "file content" },
+        { id: "m3", role: "user", contentType: "text", text: "<system-notice>\nBackground job completed" },
+    ];
+    // Gemini model: normal kernel order (text before functionResponse per #3159)
+    const geminiAdapter = createGoogleAdapter({}, undefined, undefined, "gemini-3.8-flash-high");
+    const geminiBody = geminiAdapter.buildRequest(messages, "prompt", {});
+    const geminiContents = geminiBody.contents as Array<{ role: string; parts: Array<Record<string, unknown>> }>;
+    const geminiUserParts = geminiContents[1].parts;
+    assert.equal(geminiUserParts[0].text !== undefined, true, "Gemini allows text before functionResponse");
+
+    // Claude model: functionResponse MUST precede text for Anthropic tool_result pairing
+    const claudeAdapter = createGoogleAdapter({}, undefined, undefined, "claude-opus-5-5-high");
+    const claudeBody = claudeAdapter.buildRequest(messages, "prompt", {});
+    const claudeContents = claudeBody.contents as Array<{ role: string; parts: Array<Record<string, unknown>> }>;
+    const claudeUserParts = claudeContents[1].parts;
+    assert.equal(claudeUserParts[0].functionResponse !== undefined, true, "Claude wire requires functionResponse as leading part");
+    assert.equal((claudeUserParts[0].functionResponse as Record<string, unknown>).id, "toolu_123");
+    assert.equal(claudeUserParts[1].text !== undefined, true, "subsequent text parts trail functionResponse");
+});
