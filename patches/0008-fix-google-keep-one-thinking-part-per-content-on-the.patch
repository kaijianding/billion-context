From 1870bef8f08545b6bb1ae6dc44e787a21fb44e05 Mon Sep 17 00:00:00 2001
From: "kaijian.ding" <kaijian.ding@gmail.com>
Date: Fri, 6 Nov 2026 14:02:36 +0800
Subject: [PATCH 8/8] fix(google): keep one thinking part per content on the
 Claude wire
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The Anthropic translation behind Cloud Code carries only ONE signature per
content: a second `{thought:true}` part becomes a thinking block without one
and upstream rejects the whole turn with
"messages.N.content.1.thinking.signature: Field required". The kernel fuses
consecutive model cores into a single content (two reasoning cores, then the
tool call), so this is reachable whenever a turn reasons twice before calling a
tool — which is the normal shape after a fold.

Measured by replaying a rejected body (captured with BILI_DUMP_4XX=1, session
pfa-41b4085f42822550) through a local proxy: as captured -> 400 at
messages.13.content.1; with the second thought part removed -> 200. Google
still verifies the first block's signature, so the earlier rule stands.

`ensureGoogleClaudeWireRules` now keeps the first signed thought part of each
content and drops later ones. Gemini is untouched — multiple thought parts are
its native shape.
---
 src/util.ts                  | 18 +++++++++++++++---
 tests/adapter-google.test.ts | 22 ++++++++++++++++++++++
 2 files changed, 37 insertions(+), 3 deletions(-)

diff --git a/src/util.ts b/src/util.ts
index 7d102a20e..6f90f4468 100644
--- a/src/util.ts
+++ b/src/util.ts
@@ -820,13 +820,25 @@ export function isClaudeModel(model: string | undefined): boolean {
  * here: `skip_thought_signature_validator` is not a signature on this wire
  * (see ensureGoogleThoughtSignatures), so an unsigned thought part is dropped
  * instead. Thinking blocks are optional in history, so the turn stays legal.
+ *
+ * The translation also carries only ONE signature per content: a second
+ * `{thought:true}` part in the same content becomes a thinking block with no
+ * signature, failing with the same 400 (measured by replaying a rejected body
+ * with the second thought removed -> 200). The kernel fuses consecutive model
+ * cores into one content, so two reasoning cores reliably produce that shape;
+ * only the first thought part of a content is kept.
  */
 export function ensureGoogleClaudeWireRules(contents: GoogleContent[]): GoogleContent[] {
     return contents.map((c) => {
         if (!Array.isArray(c.parts)) return c;
-        const kept = c.parts.filter(
-            (p) => !(p.thought === true && (typeof p.thoughtSignature !== "string" || p.thoughtSignature.length === 0)),
-        );
+        let thoughtSeen = false;
+        const kept = c.parts.filter((p) => {
+            if (p.thought !== true) return true;
+            if (thoughtSeen) return false;
+            if (typeof p.thoughtSignature !== "string" || p.thoughtSignature.length === 0) return false;
+            thoughtSeen = true;
+            return true;
+        });
         if (c.role !== "user") return kept.length === c.parts.length ? c : { ...c, parts: kept };
         const frs: GooglePart[] = [];
         const texts: GooglePart[] = [];
diff --git a/tests/adapter-google.test.ts b/tests/adapter-google.test.ts
index 039ba8886..47bc335da 100644
--- a/tests/adapter-google.test.ts
+++ b/tests/adapter-google.test.ts
@@ -461,3 +461,25 @@ test("google buildRequest: Claude drops thought parts that carry no signature at
     assert.equal(thoughts.length, 1, "only the signed thought survives on the Claude wire");
     assert.equal(thoughts[0].thoughtSignature, signature);
 });
+
+test("google buildRequest: Claude keeps one thinking part per content", () => {
+    // Two reasoning cores fuse into a single model content, and the Anthropic
+    // translation carries only one signature per content: the second thinking
+    // block lands without one and upstream rejects the turn with
+    // "messages.N.content.1.thinking.signature: Field required"
+    // (verified: replaying the rejected body minus that part returns 200).
+    const sig = (fill: string) => `Q0FRU3JRY0tFZ2dURUFJWUFq${fill.repeat(64)}`;
+    const messages = [
+        { id: "m1", role: "user", contentType: "text", text: "hi" },
+        { id: "m2", role: "assistant", contentType: "reasoning", text: "first thought", googleThoughtSignature: sig("A") },
+        { id: "m3", role: "assistant", contentType: "reasoning", text: "second thought", googleThoughtSignature: sig("B") },
+        { id: "m4", role: "assistant", contentType: "tool-call", toolName: "read", toolCallId: "call_1", text: "{}" },
+    ] as unknown as CoreMessage[];
+
+    const claudeBody = createGoogleAdapter({}, undefined, undefined, "claude-opus-5-5-high").buildRequest(messages, "prompt", {});
+    const claudeParts = (claudeBody.contents as Array<{ parts: Array<Record<string, unknown>> }>)[1].parts;
+    const thoughts = claudeParts.filter((p) => p.thought === true);
+    assert.equal(thoughts.length, 1, "a content carries at most one thinking block on the Claude wire");
+    assert.equal(thoughts[0].text, "first thought");
+    assert.equal(claudeParts.some((p) => p.functionCall !== undefined), true, "the tool call still ships");
+});
