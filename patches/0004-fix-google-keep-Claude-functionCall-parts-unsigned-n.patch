From 43cd652721642dd730b813bafa0fefdb73f57038 Mon Sep 17 00:00:00 2001
From: "kaijian.ding" <kaijian.ding@gmail.com>
Date: Thu, 5 Nov 2026 18:07:18 +0800
Subject: [PATCH 4/8] fix(google): keep Claude functionCall parts unsigned (no
 sentinel)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Claude models on the Google wire surface `thoughtSignature` as the
Anthropic thinking-block signature, so the Gemini fallback sentinel
("skip_thought_signature_validator") is not a signature at all: upstream
rejects the turn with "messages.N.content.0: Invalid `signature` in
`thinking` block". Verified against a captured antigravity 400 whose body
carried one real signature and 18 unsigned functionCall parts — the first
unsigned call sits in merged message 3, exactly what the error names.

ensureGoogleThoughtSignatures now takes the model and no-ops for Claude
models; the Gemini sentinel path is unchanged.
---
 src/loop/adapter-google.ts   |  2 +-
 src/server/prepare-google.ts |  4 ++--
 src/util.ts                  | 10 +++++++++-
 tests/adapter-google.test.ts | 11 +++++++++++
 4 files changed, 23 insertions(+), 4 deletions(-)

diff --git a/src/loop/adapter-google.ts b/src/loop/adapter-google.ts
index fe1b55f6e..181cd6eb5 100644
--- a/src/loop/adapter-google.ts
+++ b/src/loop/adapter-google.ts
@@ -278,7 +278,7 @@ export function createGoogleAdapter(
             if (isClaudeModel(modelVersion)) {
                 contents = ensureGoogleClaudeWireOrder(contents);
             }
-            contents = ensureGoogleThoughtSignatures(contents);
+            contents = ensureGoogleThoughtSignatures(contents, modelVersion);
             if (notes && notes.length > 0) {
                 for (const text of notes) contents.push({ role: "user", parts: [{ text }] });
             }
diff --git a/src/server/prepare-google.ts b/src/server/prepare-google.ts
index 7f1ca1e33..e741cd5bb 100644
--- a/src/server/prepare-google.ts
+++ b/src/server/prepare-google.ts
@@ -400,7 +400,7 @@ export async function prepareGoogle(
     }
 
     let finalContents = isClaudeModel(model) ? ensureGoogleClaudeWireOrder(rebuiltContents) : rebuiltContents;
-    finalContents = ensureGoogleThoughtSignatures(finalContents);
+    finalContents = ensureGoogleThoughtSignatures(finalContents, model);
     const rebuilt: GoogleRequestBody = { ...parsed, contents: finalContents, tools: toolsOut, systemInstruction };
     clampOutgoingOutput(rebuilt as Record<string, unknown>, "generationConfig.maxOutputTokens", { systemText: googleClientSystem, tools: toolsOut, processedMessages, lastInputTokens: session.stats.lastInputTokens, lastInputTokensSource: session.stats.lastInputTokensSource, nativeWindow, headroomWindow: config.modelContextLimit, imageTokens: imageReserveFor(session, "google", rebuilt, opts, upstreamOrigin), kFactor: currentCalibrationFactor(session.stats, session.metadata?.lastModel), kOrigin: session.stats.calibratedEstimateOrigin, origin: upstreamOrigin, ledgerFloorTokens: dshLedgerFloorTokens(session.metadata), knownOutputCeiling: resolveKnownOutputCeiling(req.headers, parsed as Record<string, unknown>, opts.routes, upstreamOrigin, opts.sessionHeader, model) }, sessionId, log, (c) => { session.stats.lastOutputClamp = { ...c, at: Date.now() }; });
     // #532: title-gen side requests carry their own tiny system — skip them.
@@ -445,7 +445,7 @@ export function prepareGoogleCountTokens(
         let contents = coreToGoogle(stripped as BiliMessage[]);
         const m = typeof session.metadata?.lastModel === "string" ? session.metadata.lastModel : undefined;
         if (isClaudeModel(m)) contents = ensureGoogleClaudeWireOrder(contents);
-        contents = ensureGoogleThoughtSignatures(contents);
+        contents = ensureGoogleThoughtSignatures(contents, m);
         const rebuilt: GoogleRequestBody = { ...parsed, contents };
         log("info", `[${sessionId}] countTokens pruned: ${msgs.length} → ${stripped.length} msgs`);
         return {
diff --git a/src/util.ts b/src/util.ts
index d567051e3..0833b149c 100644
--- a/src/util.ts
+++ b/src/util.ts
@@ -839,8 +839,16 @@ export const GOOGLE_SKIP_THOUGHT_SIGNATURE = "skip_thought_signature_validator";
  * generated by another model/subagent), upstream rejects with a 400 error:
  * "Function call is missing a thought_signature in functionCall parts".
  * Google documents the sentinel "skip_thought_signature_validator" as fallback.
+ *
+ * Claude models need the opposite: on the Google wire their `thoughtSignature`
+ * is re-interpreted as an Anthropic thinking-block signature, so the sentinel
+ * is not a signature at all and upstream rejects the turn with
+ * "messages.N.content.0: Invalid `signature` in `thinking` block" (verified
+ * against a live antigravity 400: 18 unsigned functionCall parts, sentinel
+ * landed on the first model turn that carries one). Leave those unsigned.
  */
-export function ensureGoogleThoughtSignatures(contents: GoogleContent[]): GoogleContent[] {
+export function ensureGoogleThoughtSignatures(contents: GoogleContent[], model?: string): GoogleContent[] {
+    if (isClaudeModel(model)) return contents;
     return contents.map((c) => {
         if (!Array.isArray(c.parts)) return c;
         let changed = false;
diff --git a/tests/adapter-google.test.ts b/tests/adapter-google.test.ts
index 587cb847a..eb7388307 100644
--- a/tests/adapter-google.test.ts
+++ b/tests/adapter-google.test.ts
@@ -389,4 +389,15 @@ test("google buildRequest: ensure functionCall parts carry thoughtSignature or f
     assert.equal(modelParts[0].thoughtSignature, "skip_thought_signature_validator", "missing signature gets fallback sentinel");
     assert.equal(modelParts[1].functionCall !== undefined, true);
     assert.equal(modelParts[1].thoughtSignature, "skip_thought_signature_validator", "missing signature on parallel call gets fallback sentinel");
+
+    // Claude models: the sentinel is NOT a valid Anthropic thinking signature —
+    // upstream rejects it with "Invalid `signature` in `thinking` block"
+    // (messages.N.content.0), so those parts must stay unsigned.
+    const claudeAdapter = createGoogleAdapter({}, undefined, undefined, "claude-opus-5-5-high");
+    const claudeBody = claudeAdapter.buildRequest(messages, "prompt", {});
+    const claudeParts = (claudeBody.contents as Array<{ role: string; parts: Array<Record<string, unknown>> }>)[0].parts;
+    assert.equal(claudeParts.length, 2, "2 tool calls emitted for Claude too");
+    assert.equal(claudeParts[0].functionCall !== undefined, true);
+    assert.equal(claudeParts[0].thoughtSignature, undefined, "Claude keeps unsigned functionCall parts unsigned");
+    assert.equal(claudeParts[1].thoughtSignature, undefined, "Claude keeps parallel unsigned calls unsigned");
 });
